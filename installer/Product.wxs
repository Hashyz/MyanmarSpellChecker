           Language="1033"
           Version="1.0.86.0"
           Manufacturer="Htet Yar Zar (ထက်ရာဇာ) — Department of Geology, Kyaukse University"
           UpgradeCode="94E1B231-7A40-4C9B-B112-65E8A9012C44">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="100% Offline Myanmar (Burmese) Spell and Grammar Checker Suite for Microsoft Word, Excel, and PowerPoint" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Myanmar Spell Checker is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProductIcon.ico" SourceFile="..\assets\branding\myanmar-spell-checker.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />

    <!-- Directory Structure: Program Files + %ProgramData%\MyanmarSpellChecker for GPO License & Encrypted DB -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="MyanmarSpellChecker" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="APPDATAFOLDER" Name="MyanmarSpellChecker" />
      </Directory>
