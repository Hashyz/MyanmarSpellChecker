<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>MyanmarSpellChecker.AdminTools</RootNamespace>
    <AssemblyName>MyanmarSpellChecker.AdminTools</AssemblyName>
    <ApplicationIcon>..\..\assets\branding\myanmar-spell-checker.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup Condition="Exists('C:\Windows\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL')">
    <Reference Include="Microsoft.Office.Interop.Word">
      <HintPath>C:\Windows\assembly\GAC_MSIL\Microsoft.Office.Interop.Word\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.Word.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('C:\Windows\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL')">
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="EmbedNuGetOfficeInteropTypes" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences;CoreCompile">
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'Office' or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Office.Interop'))">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MyanmarSpellChecker.Core\MyanmarSpellChecker.Core.csproj" />
    <ProjectReference Include="..\MyanmarSpellChecker.WordAddIn\MyanmarSpellChecker.WordAddIn.csproj" />
    <ProjectReference Include="..\MyanmarSpellChecker.ExcelAddIn\MyanmarSpellChecker.ExcelAddIn.csproj" />
    <ProjectReference Include="..\MyanmarSpellChecker.PowerPointAddIn\MyanmarSpellChecker.PowerPointAddIn.csproj" />
  </ItemGroup>

</Project>
