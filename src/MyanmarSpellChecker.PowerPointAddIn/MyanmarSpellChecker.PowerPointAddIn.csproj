<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RootNamespace>MyanmarSpellChecker.PowerPointAddIn</RootNamespace>
    <AssemblyName>MyanmarSpellChecker.PowerPointAddIn</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);HOST_POWERPOINT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyanmarSpellChecker.Core\MyanmarSpellChecker.Core.csproj" />
    <None Include="..\..\data\mlc_thatpon.db" Link="mlc_thatpon.db" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\data\mlc_thatpon.db')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AddInDiagnostics.cs" Link="AddInDiagnostics.cs" />
    <Compile Include="..\Shared\UI\UiFontCache.cs" Link="UI\UiFontCache.cs" />
    <Compile Include="..\Shared\UI\LicenseActivationForm.cs" Link="UI\LicenseActivationForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="..\Shared\UI\FixAllPreviewDialog.cs" Link="UI\FixAllPreviewDialog.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UI\PowerPointQuickFixPopup.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\PowerPointWavyUnderlineOverlay.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\PowerPointProofingTaskPaneControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UI\PowerPointProofingTaskPaneControl.*.cs">
      <DependentUpon>PowerPointProofingTaskPaneControl.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="Exists('C:\Windows\assembly\GAC\Extensibility\7.0.3300.0__b03f5f7f11d50a3a\extensibility.dll')">
    <Reference Include="Extensibility">
      <HintPath>C:\Windows\assembly\GAC\Extensibility\7.0.3300.0__b03f5f7f11d50a3a\extensibility.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('C:\Windows\assembly\GAC\Extensibility\7.0.3300.0__b03f5f7f11d50a3a\extensibility.dll')">
    <Compile Include="..\Shared\ExtensibilityInteropStub.cs" Link="Interop\ExtensibilityInteropStub.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('C:\Windows\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL')">
    <Reference Include="Office">
      <HintPath>C:\Windows\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.Office.Interop.PowerPoint">
      <HintPath>C:\Windows\assembly\GAC_MSIL\Microsoft.Office.Interop.PowerPoint\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.PowerPoint.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('C:\Windows\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL')">
    <PackageReference Include="MicrosoftOfficeCore" Version="15.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Office.Interop.PowerPoint" Version="15.0.4420.1018" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="EmbedNuGetOfficeInteropTypes" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences;CoreCompile">
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'Office' or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Office.Interop'))">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
